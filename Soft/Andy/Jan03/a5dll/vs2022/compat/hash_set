// VS2022 port: STLport-style <hash_set> mapped onto std::unordered_set.
#pragma once
#include <unordered_set>
#include <functional>
#include <memory>
namespace std
{
	template <class K, class H = hash<K>, class E = equal_to<K>, class A = allocator<K> >
	using hash_set = unordered_set<K, H, E, A>;
	template <class K, class H = hash<K>, class E = equal_to<K>, class A = allocator<K> >
	using hash_multiset = unordered_multiset<K, H, E, A>;
}
