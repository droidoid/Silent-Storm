// VS2022 port: STLport-style <hash_map> mapped onto std::unordered_map.
#pragma once
#include <unordered_map>
#include <functional>
#include <memory>
#include <utility>
namespace std
{
	template <class K, class V, class H = hash<K>, class E = equal_to<K>, class A = allocator<pair<const K, V> > >
	using hash_map = unordered_map<K, V, H, E, A>;
	template <class K, class V, class H = hash<K>, class E = equal_to<K>, class A = allocator<pair<const K, V> > >
	using hash_multimap = unordered_multimap<K, V, H, E, A>;
}
